# Copy to .env and fill in your own values. Never commit .env.

# Stripe (dev): test secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_API_KEY=sk_test_your_key_here
# Printed by: stripe listen --forward-to localhost:8080/api/v1/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
STRIPE_SUCCESS_URL=http://localhost:4200/payment/success
STRIPE_CANCEL_URL=http://localhost:4200/payment/cancel

# Database (prod)
DATABASE_URL=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=

# Auth
JWT_SECRET=

# MQTT
MQTT_HOST=localhost
MQTT_PORT=1883

SPRING_PROFILES_ACTIVE=dev
